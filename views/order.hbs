<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Product Orders</title>
</head>
<body>

    <div>
        Hello, <b>{{currentUser.username}}</b> ({{currentUser.role}})

        <form action="/logout" method="POST" style="display:inline">
            <button type="submit">
                Logout
            </button>
        </form>
    </div>

    <h1>Product Orders</h1>

    <table border="1" cellpadding="10">
        <thead>
            <tr>
                <th>Customer Name</th>
                <th>Product Name</th>
                <th>Quantity</th>
                <th>Order Date</th>
                <th>Total Price</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody>
            {{#each orders}}
                <tr>
                    <td>{{customerName}}</td>
                    <td>{{productName}}</td>
                    <td>{{quantity}}</td>

                    <td>
                        {{formatDate orderDate}}
                    </td>

                    <td>
                        {{formatPrice totalPrice}} VND
                    </td>

                    <td>
                        {{#if @root.isAdmin}}
                            <a href="/orders/update/{{_id}}">
                                Update
                            </a>

                            <form
                                action="/orders/delete/{{_id}}"
                                method="POST"
                                style="display:inline"
                            >
                                <button type="submit">
                                    Delete
                                </button>
                            </form>
                        {{else}}
                            -
                        {{/if}}
                    </td>
                </tr>
            {{/each}}
        </tbody>
    </table>

    <br>

    <a href="/orders/create">
        Create New Order
    </a>

</body>
</html>
